---
# ansible-lint reads this file too: one style for both linters
extends: default

rules:
  line-length:
    max: 100
    allow-non-breakable-words: true
  comments:
    require-starting-space: true
    min-spaces-from-content: 1
  indentation:
    spaces: consistent
    indent-sequences: consistent
  # ansible-lint's own pass disagrees on comment indentation
  comments-indentation: disable
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  # `on:` is a key in GitHub Actions workflows
  truthy:
    ignore: |
      .github/
