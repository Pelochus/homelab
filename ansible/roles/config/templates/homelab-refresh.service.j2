# {{ config_refresh_unit }}.service — generated by the homelab config role
[Unit]
Description=Refresh homelab Docker images
Documentation=file://{{ homelab_root }}/ansible/docker-refresh.yml

[Service]
Type=simple
WorkingDirectory={{ homelab_root }}/ansible
# systemd looks ExecStart up by absolute path, not through PATH.
ExecStart=/usr/bin/ansible-playbook docker-refresh.yml
TimeoutStartSec=1800
