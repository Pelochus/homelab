---
# one style for ansible, docker, and .github YAML; check with `yamlfmt -lint`
line_ending: lf
match_type: standard
extensions:
  - yml
  - yaml
include:
  - ansible
  - docker
  - .github
exclude:
  - docker/web/web
formatter:
  type: basic
  indent: 2
  include_document_start: true
  retain_line_breaks_single: true
  pad_line_comments: 1
  trim_trailing_whitespace: true
  eof_newline: true
