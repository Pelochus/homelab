#!/bin/sh
# pre-commit gate: run the repo linters and the markdown link checks before a commit.
# Both have one implementation: they live in ./lint.sh, the mirror of CI's
# .github/workflows/lint.yml. This hook only decides whether the YAML/Ansible
# checks can run: the tools are installed outside the repo, and a run where a
# tool is silently absent proves nothing, so a missing tool skips those checks
# with a note. The markdown checks need no extra tool and always run.
#
# Install: git config core.hooksPath .githooks (setup.sh does it on a fresh node)
# Override the tool location: LINT_BIN=/path/to/bin ./commit

# git runs hooks from the root of the repository
LINT_BIN=${LINT_BIN:-$HOME/.cache/homelab-lint/bin}
[ -d "$LINT_BIN" ] && PATH="$LINT_BIN:$PATH"

missing=""
for tool in ansible-lint yamllint yamlfmt
do
    command -v "$tool" > /dev/null || missing="$missing $tool"
done

if [ -n "$missing" ]
then
    echo "pre-commit: skipping the YAML/Ansible checks - missing tool:" \
        "$missing - install it outside the repo, see AGENTS.md"
    ./lint.sh markdown || exit 1
    exit 0
fi

./lint.sh || exit 1
